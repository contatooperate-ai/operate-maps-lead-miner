# === Modo de busca ===
# Deixe NICHO e LOCALIDADE em branco para rodar em MODO RODÍZIO NACIONAL:
# a cada execução, o script escolhe automaticamente (de forma determinística
# pela data) até MAX_COMBOS_POR_DIA combinações de nicho x cidade a partir de
# src/niches.py e src/cities.py, até atingir META_LEADS qualificados.
NICHO=
LOCALIDADE=

# Para rodar em modo único (um nicho + uma cidade fixos), preencha os dois:
# NICHO="dentista"
# LOCALIDADE="Uberlândia, MG"

META_LEADS=10
MAX_COMBOS_POR_DIA=8

# === Destino no CRM (Operate Hub) ===
CRM_WEBHOOK_URL=https://operate-hub-crm.lovable.app/api/public/leads/webhook
CRM_API_URL=
CRM_API_KEY=

# === Execução ===
# HEADLESS=false ajuda a depurar visualmente durante os primeiros testes
HEADLESS=true

# Quantos links de resultado coletar por lead-alvo antes de parar o scroll
OVERSCAN_FACTOR=6

# Limite de segurança de rounds de scroll no painel de resultados
MAX_SCROLL_ROUNDS=40

# Pasta onde leads_qualificados.json e leads.csv serão salvos
OUTPUT_DIR=output
